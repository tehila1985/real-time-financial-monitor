<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Generated purely so Swagger can surface the XML doc comments that
         already exist throughout the codebase — not a mandate that every
         public member gets one. CS1591 (missing XML comment) would otherwise
         flag every undocumented public member (record properties, enum
         values, the Program partial class) with a warning that adds noise
         without adding documentation value; see docs/DESIGN.md §10. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="8.0.31" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
