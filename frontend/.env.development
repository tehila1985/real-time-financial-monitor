# Local dev only: Vite's dev server (5173) and the backend (5225) are different
# origins, so API calls need an absolute base URL here (relies on the backend's
# CORS config — see backend/appsettings.Development.json). In production the
# frontend's nginx reverse-proxies /api and /hubs to the backend (same origin),
# so VITE_API_BASE_URL is unset there — see docs/DESIGN.md §18.
VITE_API_BASE_URL=http://localhost:5225
